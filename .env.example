# SmartGateAI Security Configuration Template
# DO NOT commit the actual .env file with real secrets to source control.
# Generate a cryptographically secure 256-bit token for production:
# PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))

# Required Admin Secret for all administrative endpoints (Never leave empty!)
SMARTGATE_ADMIN_API_KEY=replace_with_a_secure_random_64_character_hex_token

# Server Binding (Strictly localhost for local security)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Optional Database Overrides (defaults to local SQLite inside backend/storage)
# DATABASE_URL=sqlite:///storage/smartgate.db
